{
  "name": "polymarket-wallet-paper-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/kill-dev-bot.js",
    "dev": "tsx index.ts dev",
    "scan": "tsx index.ts scan",
    "shadow": "tsx index.ts shadow",
    "performance": "tsx index.ts performance",
    "readiness": "tsx index.ts readiness",
    "replay:audit": "tsx src/replayLiveGateAudit.ts",
    "replay:exits": "tsx src/replayExitPolicies.ts",
    "latency:sensitivity": "tsx src/latencySensitivity.ts",
    "shadow:forward": "tsx src/forwardShadowScorecard.ts",
    "shadow:size-sensitivity": "tsx src/shadowSizeSensitivity.ts",
    "shadow:walk-forward": "tsx src/walkForwardValidation.ts",
    "shadow:categories": "tsx src/shadowCategoryValidation.ts",
    "scorecard:daily": "tsx src/dailyScorecardSnapshot.ts",
    "research:wallets": "tsx src/walletResearchReport.ts",
    "research:wallets:cached": "tsx src/walletResearchReport.ts --cached",
    "research:strategies": "tsx src/strategyResearchReport.ts",
    "weather:forward": "tsx src/weatherForwardScorecard.ts",
    "weather:tournament": "tsx src/weatherTournamentReport.ts",
    "strategies:forward": "tsx src/strategyForwardScorecards.ts",
    "execution:forward": "tsx src/executionResearchScorecard.ts",
    "execution:cross-sensitivity": "tsx src/research/crossMarketSensitivity.ts",
    "macro:collect": "tsx src/research/macroNowcastCollector.ts",
    "profitability:audit": "tsx src/profitabilityAudit.ts",
    "launch:readiness": "tsx src/launchReadinessReport.ts",
    "recompute:liveexec:dry": "tsx src/recomputeLiveExecutable.ts",
    "recompute:liveexec": "tsx src/recomputeLiveExecutable.ts --apply",
    "build:server": "tsc -p tsconfig.build.json",
    "dashboard": "npm run build:server && node dist/src/dashboard/server.js",
    "dashboard:tsx": "tsx src/dashboard/server.ts",
    "export-ledger": "tsx src/exportPaperLedger.ts",
    "export-dashboard": "tsx src/dashboard/exportStatic.ts",
    "publish-dashboard": "tsx src/dashboard/publishSupabase.ts",
    "cleanup:daily:dry": "tsx scripts/dailyCleanup.ts",
    "cleanup:daily": "tsx scripts/dailyCleanup.ts --apply",
    "wallets:promote:dry": "tsx scripts/promoteDiscoveredWallets.ts",
    "wallets:promote": "tsx scripts/promoteDiscoveredWallets.ts --apply",
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}

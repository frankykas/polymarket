[Unit]
Description=PMarke daily retention cleanup
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/pmarke
ExecStartPre=-/usr/bin/systemctl stop pmarke-bot
ExecStart=/usr/bin/npm run scorecard:daily
ExecStart=/usr/bin/npm run cleanup:daily -- --keep-days 1 --keep-rows 3000
ExecStartPost=/usr/bin/systemctl start pmarke-bot

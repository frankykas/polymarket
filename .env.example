GAMMA_API_URL=https://gamma-api.polymarket.com
DATA_API_URL=https://data-api.polymarket.com
CLOB_API_URL=https://clob.polymarket.com
CLOB_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market
BOT_DB_PATH=./data/polymarket-paper-bot.sqlite
PAPER_TRADE_LEDGER_PATH=./data/paper-trade-ledger.csv

# Optional Telegram alerts. Leave blank to disable.
TELEGRAM_BOT_TOKEN=
# Private operator chat. Defaults to TELEGRAM_CHAT_ID or the first chat that sends /start.
TELEGRAM_ADMIN_CHAT_ID=
# Optional public alert-only channel/chat for approved signals and exits.
TELEGRAM_PUBLIC_CHAT_ID=

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
# Legacy single-chat fallback.
TELEGRAM_CHAT_ID=

# Conservative polling defaults.
SCAN_INTERVAL_MS=60000
WALLET_ACTIVITY_LIMIT=100
MARKET_SCAN_LIMIT=150
RESERVE_CASH_PCT=0.2
MAX_TIME_TO_RESOLUTION_HOURS=720
MAX_POSITION_HOLD_HOURS=72
DEEP_HISTORY_ENABLED=true
DEEP_HISTORY_WALLET_LIMIT=8
DEEP_HISTORY_PAGES=3
DEEP_HISTORY_PAGE_SIZE=100
RESOLUTION_BACKFILL_LIMIT=120

# Optional local admin-dashboard token. Required for non-localhost admin access.
ADMIN_DASHBOARD_TOKEN=

# Public follower tracker. This is displayed on /tracker.
PUBLIC_TRACKER_NAME=StratiFi Paper Tracker
PUBLIC_TRACKER_WALLET_ADDRESS=
PUBLIC_TRACKER_DISCLOSURE=Paper trading tracker. No live Polymarket orders are placed by this bot.
